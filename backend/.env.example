# Application Version
APP_VERSION=local-dev

# CORS Settings (comma-separated list of allowed origins)
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=unshorten_it

# Cache Configuration
# Set REDIS_URL to enable Redis. If empty, it falls back to DiskCache.
# REDIS_URL=redis://localhost:6379
CACHE_EXPIRE_SECONDS=86400

# DiskCache Configuration (fallback if Redis is not available)
DISKCACHE_DIR=/tmp/cacheservice
DISKCACHE_SIZE_LIMIT_MB=500

# Request Settings
REQUEST_TIMEOUT=10.0
TRUST_PROXIES=false

# Rate Limiter Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW=60

# URLhaus Feed Settings
# Set to true to download the full historical feed (zip-based).
# Set to false (default) to only download the recent 30-day feed (CSV-based).
URLHAUS_BACKFILL=false
SYNC_INTERVAL_SECONDS=3600

# Admin Auth Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SECRET_KEY=change_this_admin_secret_key